{
  "expo": {
    "name": "jen",
    "slug": "jen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/jen-logo.png",
    "scheme": "jen",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.ronicley.jen",
      "adaptiveIcon": {
        "backgroundColor": "#06325A",
        "foregroundImage": "./assets/images/jen-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06325A",
          "image": "./assets/images/jen-logo.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "O jen usa a câmera para fotografar etiquetas e cupons.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecione fotos de cupons para revisar suas compras.",
          "cameraPermission": "Fotografe cupons para importar suas compras.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "3a5b9d13-2899-448a-85b6-ad61b68762ef"
      }
    },
    "owner": "ronicley"
  }
}
